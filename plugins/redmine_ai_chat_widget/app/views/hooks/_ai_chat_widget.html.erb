<% mount = User.current.logged? ? ai_chat_widget_mount_data(User.current) : nil %>
<% if mount %>
  <div
    id="ai-chat-widget-root"
    data-user-id="<%= mount[:user_id] %>"
    data-user-login="<%= mount[:user_login] %>"
    data-user-role="<%= mount[:user_role] %>"
    data-widget-token="<%= mount[:widget_token] %>"
    data-backend-url="<%= mount[:backend_url] %>"
    data-platform-url="<%= mount[:platform_url] %>">
  </div>
<% end %>