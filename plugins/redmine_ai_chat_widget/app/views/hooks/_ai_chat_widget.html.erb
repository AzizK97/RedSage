<% if User.current.logged? %>
  <div
    id="ai-chat-widget-root"
    data-user-id="<%= User.current.id %>"
    data-user-login="<%= User.current.login %>"
    data-widget-token="<%= generate_widget_token(User.current) %>"
    data-backend-url="<%= Setting.plugin_redmine_ai_chat_widget['backend_url'] %>">
  </div>
<% end %>