# ── OpenRouter API Configuration ────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# ── Redmine Server Configuration ────────────────────────────────────────
# If running locally with Docker Compose, use the default
# If using external Redmine, update these values
REDMINE_URL=http://redmine:3000
REDMINE_API_KEY=your-redmine-api-key
PM_SYNC_ENABLED=true
PM_SYNC_INTERVAL_MINUTES=30
ENABLE_MONITORING=false
MONITORING_INTERVAL_SECONDS=1800
MONITORING_LOOKBACK_MINUTES=120
SLACK_WEBHOOK_URL=

# ── Docker Compose Configuration ─────────────────────────────────────────
# Backend service port
BACKEND_PORT=8000

# Redmine service port
REDMINE_PORT=3000

# PostgreSQL database credentials (replace MySQL section)
POSTGRES_DB=redmine
POSTGRES_USER=redmine
POSTGRES_PASSWORD=redmine

# Redmine secret key (for session management)
REDMINE_SECRET_KEY_BASE=change-this-to-a-random-secret-string
